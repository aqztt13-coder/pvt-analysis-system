# نظام الإدارة المتكامل — شعبة الموائع المكمنية - قسم المختبرات والسيطرة النوعية
# PVT Reservoir Fluids Division — Administrative Management System
# انسخ هذا الملف إلى .env وقم بضبط القيم لخادم الشبكة المحلية (لا تضع أي أسرار حقيقية داخل .env.example).

# عنوان الربط والمنفذ لخادم الشبكة المحلية (LAN)
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# مفتاح توقيع جلسات المصادقة (32 محرفاً عشوائياً على الأقل).
# إذا تُرك فارغاً، يقوم الخادم بتوليد مفتاح عشوائي قوي مرة واحدة وحفظه تلقائياً في قاعدة البيانات المحلية.
SESSION_SECRET=

# كلمة مرور أولية اختيارية لتهيئة حساب المدير (admin) تلقائياً عند التشغيل الأول فقط عندما تكون قاعدة البيانات فارغة من المستخدمين.
# اتركه فارغاً لاستخدام شاشة الإعداد الأولي الآمنة في المتصفح. لا يؤثر أبداً على حساب المدير بعد إنشائه.
ADMIN_INITIAL_PASSWORD=

# مجلد البيانات الإنتاجية المفصول عن الشيفرة المصدرية (يُنشئ تلقائياً data / uploads / backups / logs)
# مثال على نظام Windows: INSTANCE_DIR=D:\PVT_Division\instance
INSTANCE_DIR=./instance

# إعدادات النسخ الاحتياطي التلقائي والاحتفاظ بالنسخ
BACKUP_RETENTION_COUNT=30
AUTO_BACKUP_INTERVAL_HOURS=24
